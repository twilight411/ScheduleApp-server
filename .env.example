# ===== 应用 =====
APP_ENV=development           # development / production
APP_DEBUG=false
APP_VERSION=0.4.0

# ===== 数据库 =====
# 本地开发可以保持 SQLite（零配置）：
#DATABASE_URL=sqlite+aiosqlite:///./spirit.db

# 生产 / 多用户测试请用 PostgreSQL：
DATABASE_URL=postgresql+asyncpg://spirit:spirit_dev_pwd@localhost:5432/spirit
DATABASE_ECHO=false

# Docker 启动 PG 时的凭证
POSTGRES_USER=spirit
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=spirit

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
# 生产请生成强随机：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ===== LLM =====
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=4096
LLM_RATE_LIMIT_PER_USER_PER_HOUR=50

# ===== CORS =====
# JSON 数组字符串，FastAPI 会自动解析
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 对象存储（可选） =====
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=spirit-uploads
